NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Optional: used for absolute URLs in metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Web Push: generate with `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Any long random string; the Supabase webhook sends it in the x-push-secret header
PUSH_WEBHOOK_SECRET=
# Server-only secret key from Supabase > Project Settings > API keys
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inpsanl2bGVlc3pqbG9zb2p2anRtIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc5MTE4ODMxMCwiZXhwIjoyMTA2NzY0MzEwfQ.RiDZStSw0wZnlJQ_RzRmrWhfCjMDlWP0inQstMc5gWw

# Daily news ingest (Vercel Cron sends this as a Bearer token). Any long random string.
CRON_SECRET=

# AI reading of news headlines (gpt-5-mini). Server-only. Without it the app falls back to word-based scoring.
OPENAI_API_KEY=
